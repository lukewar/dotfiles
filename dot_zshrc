# Source zprofile only if not already loaded (avoids double-load in login shells)
[[ -z "$ZPROFILE_LOADED" ]] && { source ~/.zprofile; export ZPROFILE_LOADED=1; }

# History file
export HISTFILE=~/.zsh_history

true

# NVM — lazy-load for faster startup (loads on first use of nvm/node/npm/npx)
export NVM_DIR="$HOME/.nvm"
_nvm_load() {
  unset -f nvm node npm npx yarn pnpm
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}
nvm()  { _nvm_load; nvm  "$@"; }
node() { _nvm_load; node "$@"; }
npm()  { _nvm_load; npm  "$@"; }
npx()  { _nvm_load; npx  "$@"; }

# Python user-base bin (hardcoded to avoid spawning python3 subprocesses on startup)
export PATH="$PATH:$HOME/Library/Python/3.9/bin"

. "$HOME/.local/bin/env"


alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
# EM Workspace Shortcuts
alias em="cd ~/workspace/em && code ."
alias brewfile="brew bundle --file=~/.local/share/chezmoi/Brewfile"

# Quick Mac performance triage
slowcheck() {
  echo "=== SWAP (>2GB = pressure) ==="
  sysctl vm.swapusage | awk '{print $4, $6, $8}'

  echo ""
  echo "=== TOP 5 CPU HOGS (sudo kill -9 PID to fix) ==="
  ps aux -r | awk 'NR==1{printf "%-8s %-10s %5s %5s %s\n","PID","USER","%CPU","%MEM","COMMAND"} NR>=2 && NR<=7{printf "%-8s %-10s %5s %5s %s\n",$2,$1,$3,$4,$11}' | head -6

  echo ""
  echo "=== TOP 5 MEMORY HOGS (sudo kill -9 PID to fix) ==="
  ps aux | sort -k4 -rn | awk 'NR==1{printf "%-8s %-10s %5s %5s %s\n","PID","USER","%CPU","%MEM","COMMAND"} NR>=1 && NR<=5{printf "%-8s %-10s %5s %5s %s\n",$2,$1,$3,$4,$11}'

  echo ""
  echo "=== FREE RAM ==="
  vm_stat | awk '/Pages free/ {printf "Free: %.0f MB\n", $3*16384/1048576}'
}


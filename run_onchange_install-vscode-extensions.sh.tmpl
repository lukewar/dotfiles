#!/usr/bin/env bash
# Hash: {{ include "vscode-insiders-extensions.txt" | sha256sum }}
# Installs VS Code Insiders extensions. Stable extensions are handled by `brew bundle`.
set -euo pipefail
cd "{{ .chezmoi.sourceDir }}"

CLI="/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code"
LIST="vscode-insiders-extensions.txt"

[[ -x "$CLI" ]] || { echo "skip: VS Code Insiders not installed"; exit 0; }
[[ -f "$LIST" ]] || exit 0

echo "==> Installing VS Code Insiders extensions"
while IFS= read -r ext; do
    [[ -z "$ext" || "$ext" == \#* ]] && continue
    "$CLI" --install-extension "$ext" --force >/dev/null
done < "$LIST"
echo "==> Done"
